<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Change method to "app-store" for App Store submission -->
	<!-- Change method to "ad-hoc" for TestFlight / direct distribution -->
	<!-- Change method to "development" for dev device testing -->
	<key>method</key>
	<string>development</string>

	<!-- Your Apple Developer Team ID — find it at developer.apple.com/account -->
	<key>teamID</key>
	<string>YOUR_TEAM_ID</string>

	<key>compileBitcode</key>
	<false/>

	<key>stripSwiftSymbols</key>
	<true/>

	<key>thinning</key>
	<string>&lt;none&gt;</string>

	<!-- Set to true to upload debug symbols to Apple -->
	<key>uploadSymbols</key>
	<false/>
</dict>
</plist>
