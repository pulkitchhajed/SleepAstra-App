rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ───────────────────────────────────────────────────────
    
    // Returns true ONLY if the signed-in user's email is in the primary superadmin whitelist
    // or is explicitly registered in the /admins/ collection with active == true.
    function isAdmin() {
      return request.auth != null && request.auth.token.email != null && (
        request.auth.token.email in [
          'vennelareddy06@gmail.com',
          'sureshmereddy76@gmail.com',
          'sureshmereddy@snoreclinics.org',
          'pulkitchhajed29@gmail.com',
          'balchander18@gmail.com',
          'nadeemfazlullah@gmail.com'
        ] ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.active == true)
      );
    }

    // Returns true if the caller is authenticated (any user including anonymous).
    function isAuthenticated() {
      return request.auth != null;
    }

    // ── Users ──────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Users can only read/write their own document. Admins can read all users.
      allow read: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      allow write: if isAuthenticated() && request.auth.uid == userId;

      // Nested sleep reports — scoped to the owner only.
      match /sleep_reports/{reportId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Nested journal entries — scoped to the owner only.
      match /journal_entries/{entryId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // ── Admin Whitelist Collection ─────────────────────────────────────────────
    match /admins/{adminEmail} {
      // A user can read their own admin doc to verify status; only admins can list or modify
      allow get: if isAuthenticated() && (request.auth.token.email == adminEmail || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Admin Activity Audit Logs ───────────────────────────────────────────────
    match /admin_logs/{logId} {
      // Any authenticated user/session can record logs; admins can read all logs.
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false; // Audit logs are strictly immutable
    }

    // ── Profiles by Email ──────────────────────────────────────────────────────
    match /profiles_by_email/{email} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── Videos ─────────────────────────────────────────────────────────────────
    match /videos/{videoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ── Blogs ──────────────────────────────────────────────────────────────────
    match /blogs/{blogId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ── Audio Tracks ───────────────────────────────────────────────────────────
    match /audio_tracks/{audioId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ── Wellness Zones ─────────────────────────────────────────────────────────
    match /wellness_zones/{zoneId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ── Admin Notifications ────────────────────────────────────────────────────
    match /scheduled_notifications/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Quick Access ───────────────────────────────────────────────────────────
    match /quick_access/{accessId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
  }
}
